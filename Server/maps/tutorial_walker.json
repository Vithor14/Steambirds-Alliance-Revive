    "rules": [
      {
        "id": "start",
        "do": [
          {
            "chat": "You unlocked Quad"
          },
          {
            "area": "hangar"
          },
          {
            "guide": "instructor",
            "until": "talk_together"
          }
        ]
      },
      {
        "id": "talk_together",
        "when": {
          "line": "instructor"
        },
        "do": [
          {
            "say": "newtutorialally1"
          }
        ]
      },
      {
        "id": "turret",
        "when": {
          "line": "towers"
        },
        "do": [
          {
            "wake": "towers",
            "stagger": 0.35,
            "unless": "towers_quiet"
          }
        ]
      },
      {
        "id": "talk_bullets",
        "when": {
          "line": "bulletsTalk"
        },
        "do": [
          {
            "say": "newtutorialally1_2"
