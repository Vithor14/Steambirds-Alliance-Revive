            "say": "newtutorialally2_0_1",
            "delay": 2.5
          },
          {
            "guide": "dronesGuide",
            "seconds": 6
          }
        ]
      },
      {
        "id": "towers_quiet",
        "when": {
          "line": "towersQuiet"
        },
        "do": [
          {
            "quiet": "towers"
          }
        ]
      },
      {
