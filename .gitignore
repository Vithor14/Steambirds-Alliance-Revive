# Build output and tool caches
bin/
obj/
.vs/
*.user
*.suo
*.log
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# Local files and old copies that must never be published
FileList.txt
/_duplicates/
*.zip

# Game files and the decompiled client (not ours: they belong to Steam and to the game's developer)
/Assets/
/Asset ripper/
/Managed/
/OldVersions/
/decompiled/
/Steambirds_Data/
/BepInEx/

# Server: game data copied from the installed game (configBinary, units_config.txt, portraits...).
# Each person gets these from their own copy of the game (see README.md, "Installation").
/Server/data/

# Server: accounts of the players (one folder per Steam ID), backups and files sent by the game
/Server/accounts/
/Server/_backup/
/Server/client-uploads/
/Server/account.json
/Server/inventory.json
/Server/acceptances.json

# Server: logs and reports written while it runs
/Server/logs/
/server-report.txt
/Server/server-report.txt

# Server release zip and its build folder: output of "Build server release.ps1" (goes to GitHub Releases, never to git)
/Release/

# Launcher: output of "Build launcher.ps1" (executables, accounts, logs and local settings)
/Launcher/build/
/Launcher/dist/
/Launcher/logs/

# Launcher: images of the game for the map editor, drawn by SteambirdsGameFiles.exe from each person's own copy of the
# game (game art, not ours). Each person generates their own; the editor works without them.
/Launcher/editor-assets/

